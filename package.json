  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "~57.0.6",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-maps"
      ]
    }
  }
}
