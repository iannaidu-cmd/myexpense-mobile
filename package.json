    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "jest-expo": "~55.0.22",
    "jszip": "^3.10.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.29.0",
